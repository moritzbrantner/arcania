{
  "name": "arcania",
  "private": true,
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "install-hooks": "git config core.hooksPath .githooks",
    "ci:local": "scripts/ci-local.sh",
    "dev:backend": "cargo run -p backend",
    "dev:frontend": "cd frontend && bun run dev --host 0.0.0.0",
    "build": "cargo build --workspace && bun run --cwd frontend build",
    "test": "cargo test --workspace && bun run --cwd frontend typecheck && bun run --cwd frontend test:unit",
    "test:stories": "bun run --cwd frontend test:stories",
    "test:e2e": "playwright test --workers=1"
  },
  "packageManager": "bun@1.3.14",
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.1.0",
    "chromium-bidi": "^16.0.1"
  }
}
