# A fresh seeded Solo match: the opening hand and deck come from the seeded RNG.
{"setup": "seed:7"}
{"expect": {"round": 1, "phase": "movement", "activeSide": "player", "state": {"player": {"deckCount": 53}}}}
{"type": "startAttackPhase"}
{"type": "startCardPlay"}
{"type": "endTurn"}
{"advanceAi": "opponent", "untilDone": true}
# The AI repositions first; the Player holds priority over each pending move.
{"expect": {"phase": "movement", "activeSide": "opponent", "prioritySide": "player", "legal": [{"type": "passPriority"}]}}
{"type": "passPriority"}
{"advanceAi": "opponent", "untilDone": true}
{"type": "passPriority"}
{"advanceAi": "opponent", "untilDone": true}
{"type": "passPriority"}
# Hero AP is exhausted, but Mana still pays for Movement setup Cards.
{"expect": {"phase": "movement", "state": {"opponent": {"hero": {"apRemaining": 0, "position": {"q": 0, "r": 0}}}}}}
{"advanceAi": "opponent", "untilDone": true}
{"type": "passPriority"}
{"advanceAi": "opponent", "untilDone": true}
{"type": "passPriority"}
# The new Unit spends its partial entry AP before Attack.
{"expect": {"phase": "movement", "mana": {"opponent": 0}}}
{"advanceAi": "opponent", "untilDone": true}
{"type": "passPriority"}
{"advanceAi": "opponent", "untilDone": true}
{"expect": {"activeSide": "player", "round": 2, "phase": "movement"}}
