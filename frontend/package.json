{
  "name": "card-board-hybrid-frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test:stories": "vitest run --environment jsdom src/**/*.stories.test.tsx src/storybook/storyCoverage.test.ts"
  },
  "dependencies": {
    "@react-three/fiber": "^9.6.1",
    "@vitejs/plugin-react": "^5.1.2",
    "lucide-react": "^0.577.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "three": "^0.185.1",
    "typescript": "^5.9.3",
    "vite": "^7.2.7"
  },
  "devDependencies": {
    "@storybook/addon-vitest": "^10.4.6",
    "@storybook/react-vite": "^10.4.6",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.0",
    "jsdom": "^29.1.1",
    "storybook": "^10.4.6",
    "vitest": "^4.1.9"
  }
}
